[Unit]
Description=Weighbridge LAN dashboard (supercluster)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=americanindustrial
Group=americanindustrial
WorkingDirectory=/home/americanindustrial/weighbridge-data-entry
Environment=PATH=/home/americanindustrial/.local/node/bin:/usr/local/bin:/usr/bin
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=AIS_DASHBOARD_HOST=0.0.0.0
Environment=AIS_DASHBOARD_USER=admin
Environment=AIS_DASHBOARD_PASSWORD=ais5626
Environment=AIS_SESSION_HOURS=168
Environment=AIS_ACCESS_LOG=api
Environment=AIS_SIGNATURE_ONLY_MACS=e2:4c:e6:97:59:29
Environment=AIS_SIGNATURE_ONLY_IPS=192.168.1.171
ExecStart=/home/americanindustrial/.local/node/bin/node --no-warnings /home/americanindustrial/weighbridge-data-entry/server.js
Restart=always
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target banana-apps.target
